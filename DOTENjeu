func (p *character) UpdateEffects() {
	newEffects := []StatusEffect{}

	for _, e := range p.Effects {
		if e.TimeLeft > 0 {
			// Appliquer les dégâts
			p.PV -= e.Damage
			if p.PV < 0 {
				p.PV = 0
			}

			fmt.Println(p.Name, "subit", e.Damage, "dégâts de poison ! PV :", p.PV)

			e.TimeLeft -= e.Interval

			// Garder l’effet s’il reste du temps
			if e.TimeLeft > 0 {
				newEffects = append(newEffects, e)
			}
		}
	}

	p.Effects = newEffects
}
